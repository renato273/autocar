# Backend environment example
# URL de la base de datos PostgreSQL externa
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_bd

# Secret para firmar los JWT
JWT_SECRET=tu_secreto_jwt

# Puerto en el que escuchará el servidor (runtime en EasyPanel)
PORT=4000

# Variables de compilación (usadas en Dockerfile/CI)
NODE_ENV=production
PRISMA_GENERATE=true
