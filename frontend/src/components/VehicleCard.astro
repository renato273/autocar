// src/components/VehicleCard.astro
---
export interface Props {
  vehicle: {
    id: number;
    make: string;
    model: string;
    type: string;
    year?: number;
  };
}
---
<div class="card flex flex-col gap-2" data-id={Props.vehicle.id}>
  <h3 class="text-xl font-semibold text-primary-light">{Props.vehicle.make} {Props.vehicle.model}</h3>
  <p class="text-text-muted">Tipo: {Props.vehicle.type}</p>
  {Props.vehicle.year && <p class="text-text-muted">Año: {Props.vehicle.year}</p>}
  <div class="mt-2 flex gap-2">
    <button class="bg-primary hover:bg-primary-light text-white px-3 py-1 rounded" on:click="handleEdit">Editar</button>
    <button class="bg-red-600 hover:bg-red-500 text-white px-3 py-1 rounded" on:click="handleDelete">Eliminar</button>
  </div>
</div>
<script client:load>
  const card = document.currentScript.parentElement;
  const vehicleId = card.dataset.id;
  function handleEdit() {
    // For simplicity, redirect to edit page (not implemented yet)
    alert('Editar vehículo ' + vehicleId);
  }
  async function handleDelete() {
    if (!confirm('¿Eliminar este vehículo?')) return;
    const token = localStorage.getItem('authToken');
    try {
      const res = await fetch(`http://localhost:4000/vehicle/${vehicleId}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${token}` },
      });
      if (!res.ok) throw new Error('Error al eliminar');
      card.remove();
    } catch (e) {
      alert(e.message);
    }
  }
</script>
